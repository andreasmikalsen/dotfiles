{
  name: "Create user"
  method: "POST"
  path: "/{{api_version}}/users"
  auth: "oauth"
  content_type: "application/json"
  headers: {
    Accept: "application/json"
    X-Tenant: "{{tenant}}"
  }
  body: {
    name: "Ada Lovelace"
    email: "ada@example.invalid"
    active: true
    roles: ["developer", "reviewer"]
  }
}
